{
  "name": "rentivo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:snapshot": "node scripts/export-openapi.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/export-openapi.mjs --check && node scripts/generate-api.mjs --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "pretest": "../scripts/tests/smoke-production-stack-test.sh",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.8",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.55.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.0",
      "minimatch": "^10.0.3"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
